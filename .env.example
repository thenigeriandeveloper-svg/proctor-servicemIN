# --- required for production ---
DOMAIN=exams.example.com
# Super-admin key (creates tenants). Use a long random string: openssl rand -hex 32
ADMIN_KEY=change-me-to-a-long-random-string

# --- optional (defaults shown) ---
# RETENTION_DAYS=90               # delete snapshot images this many days after submission
# ATTEMPT_RETENTION_DAYS=0        # also erase whole attempts after N days (0 = keep forever)
# BACKUP_INTERVAL_HOURS=24        # SQLite backups in /data/backups (0 = off)
# BACKUP_KEEP=7
# RATE_LIMIT_PER_MIN=6000         # candidate requests per IP per minute (raise for big classrooms behind one NAT)
# RATE_LIMIT_API_PER_MIN=1200     # management API requests per tenant per minute
# EMBED_ORIGINS=                  # extra origins allowed to embed for ALL tenants (normally set per tenant instead)
# LOG_LEVEL=info
# ALLOW_PRIVATE_WEBHOOKS=1        # LOCAL DEVELOPMENT ONLY: lets webhooks target localhost/private IPs
