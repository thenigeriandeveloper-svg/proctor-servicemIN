{
  "name": "proctor-service",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable proctored test service that plugs into multiple websites",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "demo": "node demo.js",
    "host-demo": "node examples/host-site/server.js",
    "test": "node --disable-warning=ExperimentalWarning test/smoke.js",
    "test:e2e": "node test/e2e.js"
  },
  "engines": { "node": ">=22.13" }
}
